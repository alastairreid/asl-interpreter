
record R = { f1 : Integer, f2 : Bits(32) };

function Make() -> R
begin
    return R{ f1 => 1, f2 => Zero(32) };
end

function Change(r : R) -> R
begin
    return r with { f1 => 1, f2 => Zero(32) };
end

function Get(r : R) -> Integer
begin
    return r.f1;
end

function Set(r : R) -> R
begin
    var s := r;
    s.f1 := 42;
    return s;
end

function Tuple1(x : Integer, y : Integer) -> (Integer, Integer)
begin
    let t := (x, y);
    let (a, b) := t;
    return (a, b);
end

function Tuple2(x : Integer, y : Integer) -> (Integer, Integer)
begin
    let (a, b) := if x < y then (x, y) else (y, x);
    return (a, b);
end

enumeration Color = { Red, Green, Blue };

function Color1(x : Color) -> Color
begin
    return x;
end

function Color2(x : Color) -> Boolean
begin
    return x == Red;
end

function Color3(x : Color) -> {1..3}
begin
    case x of
        when Red => return 1;
        when Blue => return 2;
        when Green => return 3;
    endcase;
end

function Color4(x : {1..3}) -> Color
begin
    case x of
        when 1 => return Blue;
        when 2 => return Red;
        when 3 => return Green;
    endcase;
end

exception E1 = { x : Integer, y : Boolean };
exception E2 = { z : Integer };

function Get_z(e : E2) -> Integer
begin
    return e.z;
end

function Exception1(x : Integer) -> Integer
begin
    // Test throwing and catching an exception within the same function
    // (Obviously, this is not the main use-case - but it is a useful test.)
    try
      throw E2{z => x+1};
    catch
      when e : E2 => return e.z;
      otherwise => return 0;
    endtry;
    return x+2;
end

function Exception2!(x : Integer)
begin
    throw E2{z => x+1};
end

function Exception3?(x : Integer) -> Integer
begin
    if x > 0 then
        return 0;
    else
        Exception2!(x);
    endif;
end
