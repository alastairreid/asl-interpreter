/////////////////////////////////////////////////////////////////
// Memory subsystem
/////////////////////////////////////////////////////////////////

function Memory::Read(address : Bits(XLEN), size_in_bytes : {1, 2, 4}) -> Bits(8 * size_in_bytes)
begin
    // todo: consider checking alignment
    return RAM[address, size_in_bytes];
end

function Memory::Write(address : Bits(XLEN), size_in_bytes : {1, 2, 4}, value : Bits(8 * size_in_bytes))
begin
    // todo: consider checking alignment
    RAM[address, size_in_bytes] := value;
end

/////////////////////////////////////////////////////////////////
// Byte-addressable memory
//
// Note that the .isa primitives support unaligned access. If the
// ISA does not support that, then explicit checks should be added.
/////////////////////////////////////////////////////////////////

var __Memory : Std::RAM(XLEN);

function RAM::Init()
begin
    Std::RAM::Init(__Memory, 64'xdead_beef_dead_beef);
end

function RAM[address : Bits(XLEN), size_in_bytes : Integer] -> Bits(8 * size_in_bytes)
begin
    return Std::RAM::Read(__Memory, address, size_in_bytes);
end

function RAM[address : Bits(XLEN), size_in_bytes : Integer] := value : Bits(8 * size_in_bytes)
begin
    Std::RAM::Write(__Memory, address, size_in_bytes, value);
end

/////////////////////////////////////////////////////////////////
// Debugging support: print processor state
/////////////////////////////////////////////////////////////////

function Print_State()
begin
    Std::Print("PC => "); Std::Print::Bits::Hex(PC);
    Std::Print("\n");
    if Halted then
        Std::Print("HALTED\n");
    else
        Std::Print("RUNNING\n");
    endif;
    for i := 0 to 31 do
        Std::Print("  X[{i}] => ");
        Std::Print::Bits::Hex(X[i]);
        if i % 8 == 7 then
            Std::Print("\n");
        endif;
    endfor;
end

// If this function is called, it indicates that there is an gap in the specification
// caused by a missing feature.
//
// In a complete specification, there should be no calls to this function.
function Unimplemented_Feature(name : String)
begin
    Std::Print("Unimplemented feature ({name}): Report a bug in the specification\n");
    Std::End_Execution(False);
end

/////////////////////////////////////////////////////////////////
// Simulator interface
//
// This is the standard interface to the isa-tools interpreter.
// Note that the bitwidths are dictated by the isa-tools interface,
// not by the ISA.
// In particular, ISA_Tools::GetPC/SetPC operates on 64-bit values.
/////////////////////////////////////////////////////////////////

function ISA_Tool::Is_Halted() -> Boolean
begin
    return Halted;
end

function ISA_Tool::GetPC() -> Bits(64)
begin
    return Zero_Extend(PC, 64);
end

function ISA_Tool::SetPC(x : Bits(64))
begin
    PC := x[0 +: XLEN];
end

// Used when loading ELF files
function ISA_Tool::Write_Memory8(address : Bits(64), x : Bits(8))
begin
    RAM[address[0 +: XLEN], 1] := x;
end

// Read a register identified by an index.
// These indexes are arbitrary but must match the table
// used by the simulator.
// (In full ISA specifications, some or all of this code would be machine
// generated.)
function ISA_Tool::Read_Register_64(index : {0..2**16-1}) -> Bits(64)
begin
    // case index of
    //     when 0 => return Zero_Extend(PC, 64);
    //     when 1 => return (if Halted then 64'x1 else 64'x0);
    //     when {256 .. 256+31} => return Zero_Extend(X[index - 256], 64);
    //     otherwise => Unimplemented_Feature("ISA_Tool::Read_Register_64"); return Zero(64);
    // endcase;
    return Zero_Extend(PC, 64);
end

// Write a register identified by an index.
// These indexes are arbitrary but must match the table
// used by the simulator.
// (In full ISA specifications, some or all of this code would be machine
// generated.)
function ISA_Tool::Write_Register_64(index : {0..2**16-1}, val : Bits(64))
begin
    case index of
        when 0 => PC := val[0 +: XLEN];
        when 1 => Halted := val[0] == 0b1;
        when {256 .. 256+31} => X[index - 256] := val[0 +: XLEN];
        otherwise => Unimplemented_Feature("ISA_Tool::Write_Register_64");
    endcase;
end

/////////////////////////////////////////////////////////////////
// Foreign Function Interface Exports
//
// These declarations make it possible for C code to call
// the named functions.
/////////////////////////////////////////////////////////////////

foreign export function "ISA_Reset"            = Reset with {};
foreign export function "ISA_Step"             = Step with {};
foreign export function "ISA_Print_State"      = Print_State with {};
foreign export function "ISA_Is_Halted"        = ISA_Tool::Is_Halted with {};
foreign export function "ISA_GetPC"            = ISA_Tool::GetPC with { size_in_bytes => 1 };
foreign export function "ISA_SetPC"            = ISA_Tool::SetPC with { size_in_bytes => 1 };
foreign export function "ISA_Read_Memory8"     = Memory::Read with { size_in_bytes => 1 };
foreign export function "ISA_Write_Memory8"    = Memory::Write with { size_in_bytes => 1 };
foreign export function "ISA_Read_Register64"  = ISA_Tool::Read_Register_64 with {};
foreign export function "ISA_Write_Register64" = ISA_Tool::Write_Register_64 with {};

/////////////////////////////////////////////////////////////////
// Foreign Function Interface Imports
//
// These declarations replace calls to the .isa
// functions above with calls to C functions.
//
// (They are currently commented out because the
// interpreter does not support foreign import.)
/////////////////////////////////////////////////////////////////

// foreign import function "Report_Undefined" = Report_Undefined with {};
// foreign import function "Memory_Fence_TSO" = Memory_Fence_TSO with {};
// foreign import function "Pause_Execution" = Pause_Execution with {};
// foreign import function "Environment_Call" = Environment_Call with {};
// foreign import function "Environment_Break" = Environment_Break with {};
// foreign import function "Unimplemented_Feature" = Unimplemented_Feature with {};

/////////////////////////////////////////////////////////////////
// Interpreter interface
//
// For historical reasons, the interpreter uses the prefix
// ASL_. This will be updated (probably to 'ISA_Tool::'?) at some
// point in the future.
/////////////////////////////////////////////////////////////////

function ASL_Reset()
begin
    Reset();
end

function ASL_Step?()
begin
    Step?();
end

function ASL_GetPC() -> Bits(64)
begin
    return ISA_Tool::GetPC();
end

function ASL_SetPC(x : Bits(64))
begin
    ISA_Tool::SetPC(x);
end

function ASL_WriteMemory8(address : Bits(64), x : Bits(8))
begin
    ISA_Tool::Write_Memory8(address, x);
end

